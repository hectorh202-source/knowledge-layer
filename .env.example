# Supabase.
#
# The loader uses the SERVICE ROLE key, which bypasses row level security.
# That is correct for a trusted server-side loader and wrong for anything
# user-facing — the public API uses the anon key so RLS applies. Never expose
# the service role key to a browser.
#
# Not needed for `npm run content:load -- --dry-run`.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Which business is being loaded.
TENANT_SLUG=

# The customer's root domain, used for JSON-LD @id anchors and the catalog.
CATALOG_DOMAIN=

# Public URL of the deployed API. Used in the OpenAPI servers block, which the
# ARD catalog points at — a spec advertising localhost is worse than none.
API_BASE_URL=

# Google Maps Platform key, with Places API (New) enabled.
#
# This is OUR key — customers authorize nothing. Used to pull hours, address
# and rating from public Google data before any contract exists.
#
# Note: Google permits indefinite storage of place_id only. Other fields must
# not be cached long-term, so Places output is a suggestion for the owner to
# confirm, never a source of record.
GOOGLE_MAPS_API_KEY=

# Who may create agencies. Comma separated, matched case-insensitively.
#
# Deliberately an environment variable rather than a database flag: this is the
# one role that can create agencies, and it should not be grantable through a
# web form by whoever currently holds it. Editing this file and restarting is a
# slower and more visible act, which is the point.
#
# Leave empty and there is no platform tier — every user is just an agency
# member, which is the correct default for a single-agency installation.
PLATFORM_ADMIN_EMAILS=
