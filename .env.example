# ServiceTitan API credentials.
#
# IMPORTANT: these must come from a SEPARATE ServiceTitan app registration than
# the live voice booking agent. Both apps hit the same tenant, and sharing an
# app registration means sharing rate limits — a bulk export here could throttle
# the phone agent mid-call. See OPEN-QUESTIONS.md 10.1.

ST_ENV=integration          # "integration" | "production"
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=

# Supabase.
#
# The loader uses the SERVICE ROLE key, which bypasses row level security.
# That is correct for a trusted server-side loader and wrong for anything
# user-facing — the public API layer must use the anon key so RLS applies.
# Never expose the service role key to a browser.
#
# Not needed for `npm run load -- --dry-run`.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which business is being loaded. TitanZ is tenant #1.
TENANT_SLUG=titanz

# Google Maps Platform key, with Places API (New) enabled.
# This is OUR key — customers authorize nothing. Used to pre-fill a profile
# from public Google data before any contract exists.
#
# Note: Google permits indefinite storage of place_id only. Other fields must
# not be cached long-term, so Places output is a suggestion for the owner to
# confirm, never a source of record.
GOOGLE_MAPS_API_KEY=
